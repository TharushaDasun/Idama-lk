<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Idama.lk — Admin Panel</title>
<link rel="stylesheet" href="admin-panel.css">
</head>
<body>

<div id="loginScreen" class="login-screen">
  <div class="login-bg"></div>
  <div class="login-card">
    <div class="logo">Idama<span>.lk</span></div>
    <p>Admin panel — manage users and listings</p>
    <div class="f-field full" style="text-align:left;margin-bottom:14px;">
      <label>Username</label>
      <input type="text" id="adminUser" placeholder="admin">
    </div>
    <div class="f-field full" style="text-align:left;margin-bottom:10px;">
      <label>Password</label>
      <input type="password" id="adminPass" placeholder="••••••••" onkeydown="if(event.key==='Enter')attemptLogin()">
    </div>
    <div id="loginError" class="login-error hidden">Incorrect username or password</div>
    <button class="btn-primary full-w" onclick="attemptLogin()">Log in</button>
    <div class="login-note">Demo credentials — admin / admin123</div>
  </div>
</div>

<div id="dashboard" class="dash hidden">
  <div class="topbar">
    <div class="brand">Idama<span>.lk</span> Admin</div>
    <div class="who">
      <div class="avatar" id="avatarInitial">A</div>
      <span id="sellerName">Admin</span>
      <span class="logout-btn" onclick="doLogout()">Log out</span>
    </div>
  </div>

  <div class="tabs">
    <div class="tab-btn active" data-tab="overview">Overview</div>
    <div class="tab-btn" data-tab="pending">Pending</div>
    <div class="tab-btn" data-tab="reported">Reported</div>
    <div class="tab-btn" data-tab="users">Users</div>
  </div>

  <div class="panel">

    <div class="panel-section active" id="overview">
      <div class="stat-grid">
        <div class="stat-card"><div class="stat-icon-wrap c3"><svg class="stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg></div><div class="num">1,240</div><div class="label">Total users</div></div>
        <div class="stat-card"><div class="stat-icon-wrap c2"><svg class="stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"/></svg></div><div class="num">386</div><div class="label">Total listings</div></div>
        <div class="stat-card"><div class="stat-icon-wrap c1"><svg class="stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></div><div class="num">12</div><div class="label">Pending approval</div></div>
        <div class="stat-card"><div class="stat-icon-wrap c4"><svg class="stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 9v4M12 17h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg></div><div class="num">5</div><div class="label">Reported listings</div></div>
      </div>
      <span class="kicker">Dashboard</span>
      <h2 class="sec-title">Recent activity</h2>
      <p class="activity-note">6 new listings submitted for approval today. "Warehouse, Ja-Ela" was reported twice for incorrect pricing.</p>
    </div>

    <div class="panel-section" id="pending">
      <span class="kicker">Review</span>
      <h2 class="sec-title">Pending Approvals</h2>
      <table class="listings-table">
        <tr><th>Property</th><th>Category</th><th>Seller</th><th>Submitted</th><th>Status</th><th>Actions</th></tr>
        <tr><td>3BR House, Kandy</td><td>House</td><td>Nimal P.</td><td>2 hours ago</td><td><span class="status-pill pending">Pending</span></td>
          <td class="row-actions"><a href="#" class="approve" onclick="approveRow(this);return false;">Approve</a><a href="#" class="reject" onclick="rejectRow(this);return false;">Reject</a></td></tr>
        <tr><td>Beach Land, Galle</td><td>Land</td><td>Shanika W.</td><td>5 hours ago</td><td><span class="status-pill pending">Pending</span></td>
          <td class="row-actions"><a href="#" class="approve" onclick="approveRow(this);return false;">Approve</a><a href="#" class="reject" onclick="rejectRow(this);return false;">Reject</a></td></tr>
        <tr><td>Office Space, Colombo 3</td><td>Commercial</td><td>Faizal M.</td><td>1 day ago</td><td><span class="status-pill pending">Pending</span></td>
          <td class="row-actions"><a href="#" class="approve" onclick="approveRow(this);return false;">Approve</a><a href="#" class="reject" onclick="rejectRow(this);return false;">Reject</a></td></tr>
      </table>
    </div>

    <div class="panel-section" id="reported">
      <span class="kicker">Moderate</span>
      <h2 class="sec-title">Reported Listings</h2>
      <table class="listings-table">
        <tr><th>Property</th><th>Reports</th><th>Reason</th><th>Reported on</th><th>Actions</th></tr>
        <tr><td>Warehouse, Ja-Ela</td><td>2</td><td>Incorrect pricing</td><td>Yesterday</td>
          <td class="row-actions"><a href="#">View</a><a href="#" class="delete" onclick="deleteRow(this);return false;">Delete</a></td></tr>
        <tr><td>2BR Apartment, Wellawatte</td><td>1</td><td>Duplicate listing</td><td>3 days ago</td>
          <td class="row-actions"><a href="#">View</a><a href="#" class="delete" onclick="deleteRow(this);return false;">Delete</a></td></tr>
        <tr><td>10-Perch Land, Matara</td><td>3</td><td>Fake photos</td><td>4 days ago</td>
          <td class="row-actions"><a href="#">View</a><a href="#" class="delete" onclick="deleteRow(this);return false;">Delete</a></td></tr>
      </table>
    </div>

    <div class="panel-section" id="users">
      <span class="kicker">Accounts</span>
      <h2 class="sec-title">Users</h2>
      <table class="listings-table">
        <tr><th>Name</th><th>Contact</th><th>Listings</th><th>Joined</th><th>Status</th><th>Actions</th></tr>
        <tr><td>Nimal Perera</td><td>nimal@gmail.com</td><td>3</td><td>Aug 2026</td><td><span class="status-pill active">Active</span></td>
          <td class="row-actions"><a href="#" onclick="suspendRow(this);return false;">Suspend</a></td></tr>
        <tr><td>Shanika Wijesinghe</td><td>077 123 4567</td><td>1</td><td>Sep 2026</td><td><span class="status-pill active">Active</span></td>
          <td class="row-actions"><a href="#" onclick="suspendRow(this);return false;">Suspend</a></td></tr>
        <tr><td>Faizal Mohamed</td><td>faizal@gmail.com</td><td>5</td><td>Jun 2026</td><td><span class="status-pill expired">Suspended</span></td>
          <td class="row-actions"><a href="#" onclick="suspendRow(this);return false;">Activate</a></td></tr>
      </table>
    </div>

  </div>
</div>

<script src="admin-panel.js"></script>
</body>
</html>
